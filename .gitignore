# =============================================================================
# SECRETS & ENVIRONMENT — NEVER COMMIT THESE
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# =============================================================================
# AI AGENT SYSTEM (.agents/)
# — The .agents/ folder IS the team playbook and SHOULD be committed.
# — Only ignore machine-specific overrides and local scratchpads.
# =============================================================================
.agents/*.local.md
.agents/scratch/
# active_context.md  # Opcional: descomenta en proyectos donde NO quieras versionar la memoria RAM en Git

