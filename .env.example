# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copia este archivo a .env y rellena con tus credenciales locales reales.
# NUNCA agregues valores reales a este archivo ni commitees el archivo .env.
# =============================================================================

# Application
APP_NAME="AI-Native Project"
APP_ENV=local                    # local | staging | production
APP_PORT=3000
APP_URL=http://localhost:3000

# Database (ejemplo)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=project_dev
# DB_USER=postgres
# DB_PASSWORD=

# Security & Secrets
# JWT_SECRET=minimo_32_caracteres_aleatorios_y_seguros

# Third-party APIs (Obtener de los dashboards respectivos)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
